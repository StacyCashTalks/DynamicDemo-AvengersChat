@page "/"
@inject NavigationManager NavigationManager

@implements IDisposable

<PageTitle>Avengers Command Deck</PageTitle>

<div class="chat-page">
    <div class="chat-grid">
        <section class="chat-main">
            <section class="panel-surface connection-panel">
                <div class="panel-heading">
                    <div>
                        <p class="section-kicker">Network Status</p>
                        <h2>Connection Status</h2>
                    </div>
                    <span class="status-badge @(WebPubSubService.IsConnected ? "status-badge--connected" : "status-badge--disconnected")">
                        @(WebPubSubService.IsConnected ? "Online" : "Offline")
                    </span>
                </div>

                @if (!WebPubSubService.IsConnected)
                {
                    <div class="connection-panel__actions">
                        <p class="panel-copy">
                            The command deck is idle. Select a hero identity to establish a Web PubSub connection.
                        </p>
                        <a href="/signin" class="btn btn-primary action-button">
                            Connect to the Uplink
                        </a>
                    </div>
                }
                else
                {
                    <div class="connection-panel__actions">
                        <div>
                            <p class="panel-copy panel-copy--tight">
                                Active hero:
                                <strong>@_connectedHero!.Alias</strong>
                            </p>
                            <p class="panel-copy panel-copy--secondary">
                                Group channel: @_connectedHero.Group.Name
                            </p>
                        </div>
                        <button class="btn action-button action-button--secondary" @onclick="DisconnectAsync">
                            Disconnect
                        </button>
                    </div>
                }
            </section>

            @if (WebPubSubService.IsConnected)
            {
                <div class="chat-workspace">
                    <section class="panel-surface command-panel">
                        <div class="command-grid">
                            <div class="command-card">
                                <span class="command-card__label">Broadcast</span>
                                <h3>Send to All</h3>
                                <p>Push the next alert to every connected Avenger.</p>
                                <button class="btn btn-primary action-button" @onclick="SendToAllAsync">Send to All</button>
                            </div>

                            <div class="command-card">
                                <span class="command-card__label">Squad</span>
                                <h3>Send to @_connectedHero!.Group.Name</h3>
                                <p>Target the heroes in your current team channel.</p>
                                <button class="btn btn-primary action-button" @onclick="SendToGroupAsync">Send to Group</button>
                            </div>

                            <div class="command-card command-card--targeted">
                                <span class="command-card__label">Direct Message</span>
                                <h3>Send to Person</h3>
                                <p>Lock on to a single hero before dispatching the message.</p>
                                <div class="targeted-action">
                                    <select class="form-select themed-select" @bind="_selectedPersonId">
                                        <option value="">Select Person</option>
                                        @foreach (var hero in SuperHeros.SuperHeroes.Where(h => h.Id != WebPubSubService.CurrentUserId).OrderBy(h => h.Alias))
                                        {
                                            <option value="@hero.Id">@hero.Alias</option>
                                        }
                                    </select>
                                    <button class="btn btn-primary action-button" @onclick="SendToHeroAsync">Send to Person</button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="panel-surface message-panel">
                        <div class="panel-heading">
                            <div>
                                <p class="section-kicker">Live Feed</p>
                                <h2>Messages</h2>
                            </div>
                            <button class="btn action-button action-button--ghost" @onclick="ClearMessages">
                                Clear
                            </button>
                        </div>

                        <div class="message-panel__body">
                            @if (_messages.Count == 0)
                            {
                                <div class="empty-state">
                                    <p class="empty-state__headline">No transmissions yet.</p>
                                    <p class="empty-state__copy">Incoming messages will stream into this panel in real time.</p>
                                </div>
                            }
                            else
                            {
                                <div class="message-feed">
                                    @foreach (var message in _messages.OrderByDescending(m => m.SentAt))
                                    {
                                        <article class="message-card">
                                            <div class="message-card__meta">
                                                <span class="message-card__sender">@GetHeroAlias(message.FromPersonId)</span>
                                                <span class="message-card__timestamp">@message.SentAt.ToLocalTime().ToString("MMM d | h:mm tt")</span>
                                            </div>
                                            <p class="message-card__text">@message.MessageText</p>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                </div>
            }
            else
            {
                <section class="panel-surface message-panel message-panel--preview">
                    <div class="panel-heading">
                        <div>
                            <p class="section-kicker">Live Feed</p>
                            <h2>Messages</h2>
                        </div>
                    </div>
                    <div class="empty-state empty-state--preview">
                        <p class="empty-state__headline">Stand by for incoming hero traffic.</p>
                        <p class="empty-state__copy">
                            Once connected, your message stream stays visible here while controls remain within reach.
                        </p>
                    </div>
                </section>
            }
        </section>

        <aside class="panel-surface join-panel">
            <div class="panel-heading">
                <div>
                    <p class="section-kicker">Recruitment</p>
                    <h2>Join the Avengers</h2>
                </div>
            </div>
            <p class="join-panel__copy">
                Scan the code or share the URL to pull more heroes into the live demo.
            </p>
            <a class="join-panel__link" href="https://avengers-chat.stacy-clouds.dev/" target="_blank" rel="noreferrer">
                avengers-chat.stacy-clouds.dev
            </a>
            <div class="join-panel__qr-frame">
                <img src="/avengersdemoqr.png" alt="QR Code to join the demo" class="img-fluid" />
            </div>
        </aside>
    </div>
</div>

@code {
    private readonly List<Message> _messages = [];
    private string? _selectedPersonId;
    private SuperHero? _connectedHero;
    





    private async Task SendToAllAsync()
    {

    }

    private async Task SendToGroupAsync()
    {
    }
    
    private async Task SendToHeroAsync()
    {
    }

    private void ClearMessages()
    {
        _messages.Clear();
    }

    public void Dispose()
    {

    }
}
